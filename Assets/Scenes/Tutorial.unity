  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CaptureBlackout
  settings: {fileID: 11400000, guid: 38a37a9d0f412c147a90ca6d3e4c0e0e, type: 2}
  playerCaught: {fileID: 11400000, guid: 9531aa4d2f332064c9378b427d376f9e, type: 2}
  bottleDropped: {fileID: 11400000, guid: 4ac3ee28c150c403e8ce119c5b300be0, type: 2}
  hintRequested: {fileID: 11400000, guid: c07f8f93dcd6e4645a1309bdddfa7b10, type: 2}
  firstLine: They saw me.
  againLine: Again...
  firstThought: 'Back in the cell. Breathe.

    The pale light is the camera''s
    eye. I wait in the dark until it turns away.'
  againThought: Breathe. Watch the light. Wait for it to turn.
  lostBottleThought: 'They took the bottle back to the storage room.

    I''ll try
    again. Slower this time.'
  fadeInSeconds: 0.5
  fadeOutSeconds: 1.5
  caughtVolume: 0.9
